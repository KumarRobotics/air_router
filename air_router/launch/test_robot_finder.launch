<?xml version="1.0" encoding="UTF-8"?>
<launch>

  <arg name="output" default="screen"/>

  <arg name="initial_expl_time" default="5"/>
  <arg name="short_expl_time" default="5"/>
  <arg name="after_search_time" default="5"/>
  <arg name="recent_pose_time_threshold" default="5"/>
  <arg name="tracking_time" default="10"/>
  <arg name="acceptance_radius" default="2"/>
  <arg name="sim" default="true"/>
  <arg name="max_edge_length" default="101" />
  <arg name="robot_list" default="io,callisto"/>
  <!-- <arg name="world_config_path" default="$(find-pkg-share semantics_manager)/config/config_sim.yaml"/> -->
  <arg name="world_config_path" default="/home/jonathan/temp/config.yaml"/>
  

  <!-- ==================== LAUNCH NODES ================== -->
  
  <node pkg="air_router" exec="navigator" name="navigator" output="$(var output)">
    <param name="acceptance_radius" value="$(var acceptance_radius)" />
    <param name="sim" value="$(var sim)" />
    <param name="world_config_path" value="$(var world_config_path)" />
    <param name="max_edge_length" value="$(var max_edge_length)" />
  </node>

  <node pkg="air_router" exec="robot_finder" name="robot_finder" output="$(var output)">
    <param name="initial_exploration_time" value="$(var initial_expl_time)"/>
    <param name="short_exploration_time" value="$(var short_expl_time)"/>
    <param name="after_search_time" value="$(var after_search_time)"/>
    <param name="tracking_time" value="$(var tracking_time)"/>
    <param name="recent_pose_time_threshold" value="$(var recent_pose_time_threshold)"/>
    <param name="robot_list" value="$(var robot_list)"/>
  </node>

  <!-- Load the test node -->
  <node pkg="air_router" exec="test_robot_finder" name="test_robot_finder" output="$(var output)">
    <param name="world_config_path" value="$(var world_config_path)" />
    <param name="max_edge_length" value="$(var max_edge_length)" />
  </node>

</launch>
